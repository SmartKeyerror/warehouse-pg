-- Test the scenario which the huge gxid

-- start_matchsubs
-- m/cdbdistributedxid.c:\d+/
-- s/cdbdistributedxid.c:\d+/cdbdistributedxid.c:LINE/
-- m/cdbdistributedxacts.c:\d+/
-- s/cdbdistributedxacts.c:\d+/cdbdistributedxacts.c:LINE/
-- end_matchsubs

-- let the gxid exceed UINTMAX
select gp_set_next_gxid(4294967296); -- UINTMAX is 4294967295 select gp_get_next_gxid();
 gp_get_next_gxid 
------------------
 4294967296       
(1 row)

-- these 3 functions/view only work when using gp_toolkit version
begin;
BEGIN
select gp_distributed_xid();
ERROR:  This function/view contains a bug: It returns incorrect result when DistributedTransactionId exceeds UINT_MAX(4294967295) (cdbdistributedxid.c:30)
HINT:  Please use gp_toolkit.gp_distributed_xid as a replacement.
end;
ROLLBACK
begin;
BEGIN
select gp_toolkit.gp_distributed_xid();
 gp_distributed_xid 
--------------------
 4294967297         
(1 row)
end;
COMMIT

begin;
BEGIN
select * from gp_distributed_xacts;
ERROR:  This function/view contains a bug: It returns incorrect result when DistributedTransactionId exceeds UINT_MAX(4294967295) (cdbdistributedxacts.c:95)
HINT:  Please use gp_toolkit.gp_distributed_xacts as a replacement.
end;
ROLLBACK
begin;
BEGIN
select distributed_xid,state,xmin_distributed_snapshot from gp_toolkit.gp_distributed_xacts order by distributed_xid desc limit 1;
 distributed_xid | state | xmin_distributed_snapshot 
-----------------+-------+---------------------------
 4294967299      | None  | 4294967299                
(1 row)
end;
COMMIT

